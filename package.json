{
  "name": "marble-taxonomy",
  "version": "1.0.0",
  "description": "An open, graph-structured taxonomy of primary/elementary learning.",
  "private": true,
  "type": "module",
  "license": "(ODbL-1.0 AND CC-BY-SA-4.0)",
  "homepage": "https://withmarble.com",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test scripts/*.test.mjs",
    "player:install": "npm --prefix player ci",
    "player:dev": "npm --prefix player run dev",
    "player:start": "npm --prefix player start",
    "player:test": "npm --prefix player test",
    "player:test:browser": "npm --prefix player run test:browser",
    "skill:validate": "python3 .agents/skills/marble-voice-builder/scripts/validate_bundle.py"
  }
}
