        "type": "number"
      },
      "moonAltitude": {
        "type": "number"
      },
      "canTurn": {
        "type": "boolean"
      },
      "canMoveMoon": {
        "type": "boolean"
      },
      "canAnswer": {
        "type": "boolean"
      },
      "instruction": {
        "type": "string"
      }
    },
