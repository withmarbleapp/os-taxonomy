      "task",
      "mode",
      "moment",
      "demonstratedMoments",
      "sceneId",
      "theta",
      "phi",
      "originTheta",
      "view",
      "horizon",
      "rays",
      "assisted",
      "revealed",
      "path",
      "attempts",
      "day",
      "moonAboveHorizon",
      "sunAltitude",
      "moonAltitude",
      "canTurn",
      "canMoveMoon",
      "canAnswer",
      "instruction"
    ],
    "additionalProperties": false
  },
  "actions": [
    {
      "name": "show_moment",
      "description": "Show and narrate one moment, then continue this turn into a learner question or activity. night_light introduces reflected light; daytime_light applies the same route by day; blocked_light shows Earth blocking the view. light_journey and horizon support CURRENT work. horizon displays the rose-colored line labeled Horizon: use that visible name when referring to it in either view. daytime_moon/daytime_without_moon show the explorer sky. New setups require resolving or leaving pending work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "moment": {
            "enum": [
              "night_light",
              "daytime_light",
              "blocked_light",
              "daytime_moon",
              "light_journey",
              "horizon",
              "daytime_without_moon"
            ]
          }
        },
        "required": [
          "moment"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_activity",
      "description": "Start and introduce a task. turn_earth: find a position where reflected moonlight reaches the explorer (night or day), then inspect their sky; use after reflection is familiar. predict_sky: fresh geometry without rays, for transfer after supported understanding. build_light_path: construct the route. Pending work must first be answered or left.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "activity": {
            "enum": [
              "turn_earth",
              "predict_sky",
              "build_light_path"
            ]
          }
        },
        "required": [
          "activity"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_check",
      "description": "Start a supported check with rays and horizon retained. The runtime speaks the exact on-screen question. day_night uses Day/Night; moon_visible uses Yes/No to above-horizon. Await an answer; do not invent another question.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "enum": [
              "day_night",
              "moon_visible"
            ]
          },
          "situation": {
            "enum": [
              "night",
              "day",
              "below"
            ]
          }
        },
        "required": [
          "question",
          "situation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "answer_check",
      "description": "Resolve a clear SPOKEN answer to the pending binary question. Use its sceneId and quote the learner’s actual words. true means Day or Yes; false means Night or No. The model scores it and records voice provenance. Never use for a hypothetical, unclear reply, or answer supplied by the tutor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "answer": {
            "type": "boolean"
          },
          "words": {
            "type": "string",
            "minLength": 1,
            "maxLength": 650
          }
        },
        "required": [
          "sceneId",
          "answer",
          "words"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "leave_activity",
      "description": "Leave unfinished work when the child chooses another activity or asks to move on. Preserve prior attempts; do not invent an answer.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "set_view",
      "description": "Navigate the CURRENT arrangement between space and the explorer sky, without resetting work. Use when the child asks to look through the explorer’s eyes or return to space; do it rather than asking permission again. For teaching a new idea prefer show_moment. Revealing sky before a prediction marks help.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "view": {
            "enum": [
              "space",
              "sky"
            ]
          }
        },
        "required": [
          "view"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "resume_activity",
      "description": "Return control to the child after demonstrating support on their current activity, or reopen their checked response for assisted correction. Preserve geometry and original attempts; do not manufacture a fresh independent success. Unavailable if no activity exists.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
