              "type": "boolean"
            },
            "assisted": {
              "type": "boolean"
            },
            "modality": {
              "enum": [
                "button",
                "voice"
              ]
            },
            "words": {
              "type": "string"
            },
            "theta": {
              "type": "number"
            },
            "phi": {
              "type": "number"
            }
          },
          "required": [
            "id",
            "sceneId",
            "task",
            "answer",
            "correct",
            "assisted",
            "modality",
            "words",
            "theta",
            "phi"
          ],
          "additionalProperties": false
        },
