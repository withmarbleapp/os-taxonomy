{
  "protocolVersion": 1,
  "kind": "moon-daytime",
  "apiVersion": 1,
  "releaseId": "moon-daytime-v7",
  "description": "Illustrative Sun–Earth–Moon geometry with a linked observer sky. day means Sun above the local horizon; moonAboveHorizon means Moon above it. Distances and body sizes are not to scale. This is not a real-date sky forecast: clouds, glare/contrast, eclipses, refraction and orbit tilt are omitted. Predictions use daylight quarter-like arrangements well away from the horizon and Sun. Above horizon is NOT a guarantee of real-world visibility. Turning Earth changes the observer; looking around only changes the camera. Ground view hides bodies below the horizon. Rays explain reflected sunlight, not eyes emitting light. Exact responses and assistance are separate from interpreted explanations. No completion threshold.",
  "stateSchema": {
    "type": "object",
    "properties": {
      "task": {
        "enum": [
          "demonstration",
          "explore",
          "prediction",
          "daylight",
          "path"
        ]
      },
      "mode": {
        "enum": [
          "demonstration",
          "activity"
        ]
      },
      "moment": {
        "type": "string"
      },
      "demonstratedMoments": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 7
      },
      "sceneId": {
        "type": "string"
      },
      "theta": {
        "type": "number"
      },
      "phi": {
        "type": "number"
      },
      "originTheta": {
        "type": "number"
      },
      "view": {
        "enum": [
          "space",
          "sky"
        ]
      },
      "horizon": {
        "type": "boolean"
      },
      "rays": {
        "type": "boolean"
      },
      "assisted": {
        "type": "boolean"
      },
      "revealed": {
        "type": "boolean"
      },
      "path": {
        "type": "array",
        "items": {
          "enum": [
            "sun",
            "moon",
            "observer"
          ]
        },
        "maxItems": 3
      },
      "attempts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "sceneId": {
              "type": "string"
            },
            "task": {
              "enum": [
                "demonstration",
                "explore",
                "prediction",
                "daylight",
                "path"
              ]
            },
            "answer": {
              "type": "string"
            },
