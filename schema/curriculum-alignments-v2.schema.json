{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withmarble.com/taxonomy/schema/curriculum-alignments-v2.schema.json",
  "title": "Marble Skill Taxonomy \u2014 scoped curriculum alignments v2",
  "description": "Preparation contract with explicit applicability scope and preserved age intervals. Use the semantic checker for identity, source membership, references and age ordering.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "alignments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "alignments": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "topicId",
              "scope",
              "ageRangeStart",
              "ageRangeEnd",
              "standards",
              "country"
            ],
            "properties": {
              "topicId": {
                "type": "string",
                "pattern": "^mt_[A-Za-z0-9_-]+$"
              },
              "scope": {
                "type": "string",
                "const": "jurisdiction"
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ageRangeStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ageRangeEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "standards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[^:\\s]+:.+$"
                }
              },
              "ageOnly": {
                "type": "boolean",
                "const": true
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "topicId",
              "scope",
              "ageRangeStart",
              "ageRangeEnd",
              "standards",
              "framework"
            ],
            "properties": {
              "topicId": {
                "type": "string",
                "pattern": "^mt_[A-Za-z0-9_-]+$"
              },
              "scope": {
                "type": "string",
                "const": "framework"
              },
              "framework": {
                "type": "string",
                "pattern": "^[^:\\s]+$"
              },
              "ageRangeStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ageRangeEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "standards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[^:\\s]+:.+$"
                }
              },
              "ageOnly": {
                "type": "boolean",
                "const": true
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "topicId",
              "scope",
              "ageRangeStart",
              "ageRangeEnd",
              "standards",
              "ageOnly"
            ],
            "properties": {
              "topicId": {
                "type": "string",
                "pattern": "^mt_[A-Za-z0-9_-]+$"
              },
              "scope": {
                "type": "string",
                "const": "global"
              },
              "ageRangeStart": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ageRangeEnd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "standards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[^:\\s]+:.+$"
                },
                "maxItems": 0
              },
              "ageOnly": {
                "type": "boolean",
                "const": true
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
