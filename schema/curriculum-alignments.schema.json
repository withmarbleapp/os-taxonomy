{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://withmarble.com/taxonomy/schema/curriculum-alignments.schema.json",
  "title": "Marble Skill Taxonomy — curriculum alignment authoring contract",
  "description": "Preparation contract. Use the accompanying semantic validator for references, unique contexts, age ordering and intentional age-only records.",
  "type": "object",
  "required": ["schemaVersion", "version", "alignments"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "alignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "country", "ageRangeStart", "ageRangeEnd", "standards"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^mt_[A-Za-z0-9_-]+$" },
          "country": { "type": "string", "pattern": "^(?:[A-Z]{2}|International)$" },
          "region": { "type": ["string", "null"] },
          "ageRangeStart": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "ageRangeEnd": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "standards": { "type": "array", "items": { "type": "string", "pattern": "^[^:\\s]+:.+$" } },
          "ageOnly": { "type": "boolean", "const": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
